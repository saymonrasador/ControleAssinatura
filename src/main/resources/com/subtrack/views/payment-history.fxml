<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.subtrack.controller.PaymentHistoryController"
            styleClass="root">

    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="16">
            <Label text="Histórico de Pagamentos" styleClass="label-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Voltar para Dashboard" styleClass="btn-outline,btn-small"
                    onAction="#handleBack"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="16" style="-fx-padding: 20;">

            <!-- Filters -->
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="card-flat">
                <Label text="Filtros:" styleClass="label-muted"/>
                <ComboBox fx:id="subscriptionFilter" promptText="Assinatura" prefWidth="160"/>
                <ComboBox fx:id="categoryFilter" promptText="Categoria" prefWidth="160"/>
                <ComboBox fx:id="payMethodFilter" promptText="Método de Pagamento" prefWidth="180"/>
                <TextField fx:id="competenceField" promptText="Ciclo (YYYY-MM)" prefWidth="120"/>
                <DatePicker fx:id="startDatePicker" promptText="De" prefWidth="130"/>
                <DatePicker fx:id="endDatePicker" promptText="Até" prefWidth="130"/>
                <Button text="Buscar" onAction="#handleSearch" styleClass="btn-small"/>
                <Button text="Limpar" styleClass="btn-outline,btn-small" onAction="#handleClear"/>
            </HBox>

            <!-- Content: Table + Pie Chart -->
            <SplitPane dividerPositions="0.53" VBox.vgrow="ALWAYS" prefHeight="340">
                <TableView fx:id="historyTable">
                    <columns>
                        <TableColumn fx:id="colCompetence" text="Ciclo" prefWidth="100"/>
                        <TableColumn fx:id="colSubscription" text="Assinaturas" prefWidth="150"/>
                        <TableColumn fx:id="colCategory" text="Categoria" prefWidth="120"/>
                        <TableColumn fx:id="colPayMethod" text="Método de Pagamento" prefWidth="120"/>
                        <TableColumn fx:id="colAmount" text="Valor" prefWidth="80"/>
                        <TableColumn fx:id="colDate" text="Data Pagamento" prefWidth="120"/>
                        <TableColumn fx:id="colActions" text="" prefWidth="60" sortable="false" resizable="false"/>
                    </columns>
                </TableView>

                <VBox spacing="10" style="-fx-padding: 0 0 0 10;">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Visualizar por:" styleClass="label-muted"/>
                        <ComboBox fx:id="chartModeSelector" prefWidth="200"
                                  onAction="#handleChartModeChange"/>
                    </HBox>
                    <PieChart fx:id="historyPieChart"
                              prefHeight="240" legendVisible="true" labelsVisible="false"/>
                    <Label fx:id="totalLabel" text="Total: R$0,00"
                           styleClass="spending-amount" style="-fx-font-size: 20px;"/>
                </VBox>
            </SplitPane>

            <!-- Trend Line Chart -->
            <VBox spacing="8" styleClass="card-flat" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="0">
                    <Label text="Evolução de Gastos por Ciclo" styleClass="label-subtitle"
                           style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                </HBox>
                <LineChart fx:id="trendChart" VBox.vgrow="ALWAYS" prefHeight="220"
                           animated="true" createSymbols="true" legendVisible="false">
                    <xAxis>
                        <CategoryAxis fx:id="trendXAxis" label="Ciclo"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis fx:id="trendYAxis" label="Total (R$)" forceZeroInRange="true"/>
                    </yAxis>
                </LineChart>
            </VBox>
        </VBox>
    </center>
</BorderPane>
